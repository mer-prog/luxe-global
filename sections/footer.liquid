<style>
  .section-footer {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .section-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  @media screen and (min-width: 768px) {
    .section-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    .section-footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }

  .section-footer__brand-name {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  .section-footer__brand-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 320px;
  }

  .section-footer__heading {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  .section-footer__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .section-footer__link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .section-footer__link:hover {
    color: var(--color-accent);
  }

  .section-footer__ecosystem {
    border-top: 1px solid var(--color-border);
    padding: var(--space-xl) 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media screen and (min-width: 768px) {
    .section-footer__ecosystem {
      grid-template-columns: 1fr 1.4fr;
      align-items: start;
    }
  }

  .section-footer__ecosystem-title {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    margin: 0 0 var(--space-xs);
  }

  .section-footer__ecosystem-subtitle {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 360px;
    margin: 0;
  }

  .section-footer__ecosystem-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 1024px) {
    .section-footer__ecosystem-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .section-footer__ecosystem-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-border);
  }

  @media screen and (min-width: 1024px) {
    .section-footer__ecosystem-item {
      padding: 0 var(--space-md) 0 0;
      border-top: 0;
      border-left: 1px solid var(--color-border);
      padding-left: var(--space-md);
    }

    .section-footer__ecosystem-item:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }

  .section-footer__ecosystem-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
    letter-spacing: 0.02em;
  }

  .section-footer__ecosystem-label:hover {
    color: var(--color-accent);
  }

  .section-footer__ecosystem-label[aria-current="page"] {
    color: var(--color-accent);
  }

  .section-footer__ecosystem-meta {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }

  .section-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  @media screen and (min-width: 768px) {
    .section-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .section-footer__copyright {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .section-footer__payment-icons {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
  }

  .section-footer__payment-icon svg {
    width: 38px;
    height: 24px;
  }
</style>

<footer class="section-footer">
  <div class="page-width">
    <div class="section-footer__grid">
      {%- comment -%} Brand column {%- endcomment -%}
      <div class="section-footer__col">
        <p class="section-footer__brand-name">{{ shop.name }}</p>
        {%- if section.settings.footer_description != blank -%}
          <p class="section-footer__brand-text">{{ 'sections.footer.defaults.description' | t | default: section.settings.footer_description }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} Link columns via blocks {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div class="section-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h4 class="section-footer__heading">{{ block.settings.heading }}</h4>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="section-footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}" class="section-footer__link">
                        {{ link.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Mer Forge ecosystem cross-links {%- endcomment -%}
    <div class="section-footer__ecosystem">
      <div class="section-footer__ecosystem-intro">
        <h4 class="section-footer__ecosystem-title">{{ 'sections.footer.mer_forge_ecosystem.title' | t }}</h4>
        <p class="section-footer__ecosystem-subtitle">{{ 'sections.footer.mer_forge_ecosystem.subtitle' | t }}</p>
      </div>
      <ul class="section-footer__ecosystem-list">
        <li class="section-footer__ecosystem-item">
          <a
            class="section-footer__ecosystem-label"
            href="https://github.com/mer-prog/mer-forge"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ 'sections.footer.mer_forge_ecosystem.lp_label' | t }} — {{ 'sections.footer.mer_forge_ecosystem.github_label' | t }}"
          >
            {{ 'sections.footer.mer_forge_ecosystem.lp_label' | t }}
          </a>
          <span class="section-footer__ecosystem-meta">{{ 'sections.footer.mer_forge_ecosystem.github_label' | t }}</span>
        </li>
        <li class="section-footer__ecosystem-item">
          <a
            class="section-footer__ecosystem-label"
            href="https://github.com/mer-prog/mer-forge-demos"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ 'sections.footer.mer_forge_ecosystem.demo_label' | t }} — {{ 'sections.footer.mer_forge_ecosystem.github_label' | t }}"
          >
            {{ 'sections.footer.mer_forge_ecosystem.demo_label' | t }}
          </a>
          <span class="section-footer__ecosystem-meta">{{ 'sections.footer.mer_forge_ecosystem.github_label' | t }}</span>
        </li>
        <li class="section-footer__ecosystem-item">
          <a
            class="section-footer__ecosystem-label"
            href="https://github.com/mer-prog/luxe-global"
            target="_blank"
            rel="noopener noreferrer"
            aria-current="page"
            aria-label="{{ 'sections.footer.mer_forge_ecosystem.this_label' | t }} — {{ 'sections.footer.mer_forge_ecosystem.github_label' | t }}"
          >
            {{ 'sections.footer.mer_forge_ecosystem.this_label' | t }}
          </a>
          <span class="section-footer__ecosystem-meta">{{ 'sections.footer.mer_forge_ecosystem.github_label' | t }}</span>
        </li>
      </ul>
    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="section-footer__bottom">
      <p class="section-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {{ 'sections.footer.rights' | t }}
        {{ powered_by_link }}
      </p>

      {%- if section.settings.show_payment_icons -%}
        <div class="section-footer__payment-icons">
          {%- for type in shop.enabled_payment_types -%}
            <span class="section-footer__payment-icon">
              {{ type | payment_type_svg_tag }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "section-footer-wrapper",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_description",
      "default": "t:sections.footer.defaults.description",
      "label": "t:sections.footer.settings.footer_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "default": true,
      "label": "t:sections.footer.settings.show_payment_icons.label"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "t:sections.footer.defaults.quick_links",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "t:sections.footer.presets.name",
      "blocks": [
        { "type": "link_list" },
        { "type": "link_list" }
      ]
    }
  ]
}
{% endschema %}
